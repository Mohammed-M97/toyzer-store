# ---------------------------------------------------------------------------
# Copy to backend/.env (or the repo root .env) and fill in real values.
# NEVER commit the filled-in file. See docs/SECURITY-ROTATION.md
# ---------------------------------------------------------------------------

# Server
PORT=5000
NODE_ENV=development

# Public URL of the frontend. Used for Stripe redirect URLs and CORS.
# Local:      http://localhost:5173
# Production: https://toyzer-store.onrender.com
CLIENT_URL=http://localhost:5173

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/toyzer?retryWrites=true&w=majority

# Redis (Upstash). Optional - the app runs without it, just uncached.
UPSTASH_REDIS_URL=rediss://default:<token>@<host>.upstash.io:6379

# JWT secrets. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_TOKEN=
JWT_REFRESH_TOKEN=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Stripe
STRIPE_SECRET_KEY=
